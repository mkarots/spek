# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real credentials.

# Required: Anthropic API key used by the agent loop and spec parser.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model slug used by the agent loop and spec parser.
# Defaults to `evals-anthropic/claude-sonnet-4-6` if unset.
# ANTHROPIC_MODEL=evals-anthropic/claude-sonnet-4-6

# Optional: override the Anthropic API base URL (e.g. for an internal proxy).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
